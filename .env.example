# =============================================================================
# lwaiwork - docker compose 环境变量模板
#
# 用法：cp .env.example .env  然后填写下面的值
# 注意：.env 已在 .gitignore 中，绝对不要提交到仓库
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库（compose 内 postgres 服务使用）
# 生产环境务必改成强密码，不要用默认的 postgres/postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=请改成强密码
POSTGRES_DB=lwaiwork

# -----------------------------------------------------------------------------
# JWT 密钥（必填，缺失时 compose 会直接报错拒绝启动）
# 生成命令（两条都要生成，值不能相同）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=用上面的命令生成48字节随机串
JWT_REFRESH_SECRET=再生成一条不同的48字节随机串
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# TypeORM 自动建表
#   true  = 启动时自动同步表结构（仅 M1 验证期使用，方便快速起链路）
#   false = 生产必须设为 false，改用 migrations 目录里的迁移脚本
# -----------------------------------------------------------------------------
TYPEORM_SYNCHRONIZE=true

# -----------------------------------------------------------------------------
# 前端 API 地址（关键）
#
# NEXT_PUBLIC_* 变量在 BUILD 阶段被内联进浏览器 JS 包，运行时改无效，
# 改了必须重新 build 前端镜像。
#
# 因为内联进的是「浏览器」包，所以这里必须填浏览器能解析的地址，
# 不能填 docker 服务名（http://backend:4000/api 浏览器解析不了）。
#
#   M1 阶段用服务器 IP 直连验证：
#     NEXT_PUBLIC_API_BASE_URL=http://8.130.181.74:4001/api
#   配好 Nginx + SSL 后切换到域名：
#     NEXT_PUBLIC_API_BASE_URL=https://api.wb.lwai.work/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://8.130.181.74:4001/api
