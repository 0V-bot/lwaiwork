# ---------------------------------------------------------------------------
# Backend base URL. The NestJS app exposes everything under the global prefix
# /api (see backend/src/main.ts -> app.setGlobalPrefix('api')).
#
# Backend listens on 4000 (container/process). ECS 8.130.181.74 already occupies
# 22 / 80 / 443 / 3000, so the backend was moved OFF 3000. Host mappings:
#   bare metal / npm run start:dev -> http://localhost:4000/api
#   docker-compose                -> http://localhost:4001/api
#
# This is a NEXT_PUBLIC_ variable: it is inlined into the browser bundle at BUILD
# time, not read at runtime. Changing it requires `npm run build` again.
#
# WARNING: because it is inlined into the BROWSER bundle, this must be a URL the
# browser can actually resolve. A docker service name (http://backend:4000/api)
# only works for server-side rendering - the browser cannot resolve it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
