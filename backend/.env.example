# ---------------------------------------------------------------------------
# lwaiwork backend - environment template
# Copy to `.env` before running. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Server
# PORT=4000 (was 3000). ECS 8.130.181.74 already occupies 22 / 80 / 443 / 3000,
# so 3000 collides with an existing project. 4000 is free.
#   container/process port : 4000
#   docker-compose host map: 4001  (see docker-compose.yml)
NODE_ENV=development
PORT=4000

# Comma separated list of allowed origins (no trailing slash)
#   http://localhost:3001    -> frontend dev server / compose frontend host port
#   https://wb.lwai.work     -> production origin
#   http://8.130.181.74:3001 -> TEMPORARY direct-IP access; drop once the domain
#                               is fronted by Nginx
CORS_ORIGINS=https://wb.lwai.work,http://localhost:3001,http://8.130.181.74:3001

# PostgreSQL
# Host port 5433 (5432 is the conventional port and easier to scan / collide on).
# Inside docker-compose the backend uses the service name instead:
#   postgres://postgres:postgres@postgres:5432/lwaiwork
DATABASE_URL=postgres://postgres:postgres@localhost:5433/lwaiwork

# Redis - host port 6380; inside compose: redis://redis:6379
REDIS_URL=redis://localhost:6380

# JWT secrets - MUST be overwritten in every environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_48_byte_random_hex_string
JWT_REFRESH_SECRET=replace_me_with_another_48_byte_random_hex_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# TypeORM
# MVP allows synchronize:true. PRODUCTION MUST SET THIS TO false and run migrations.
TYPEORM_SYNCHRONIZE=true
